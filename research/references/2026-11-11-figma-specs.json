  "classify": "Hand-edited feature film for a document product, told as one artefact's arc. Conventions: a hero button, typing close-ups, collaborator cursors, a two-line end card.",
  "diagnose": [
    {
      "observation": "The same PRD is on screen, or referenced, in every chapter.",
      "principle": "Continuity of subject: the viewer follows one object across cuts, so each cut reads as 'the same doc, a step later'."
    },
    {
      "observation": "Named collaborator cursors move in the background of most shots.",
      "principle": "Secondary action: the cursors say 'multiplayer' without a shot of their own."
    },
    {
      "observation": "Prompts and comments are typed at ×2–3.",
      "principle": "Typing close-up: the words are the content, so they get the frame."
    },
    {
      "observation": "Cross-dissolves of 1.5–2.4 s between 1 s shots.",
      "principle": "Pacing mismatch: the transition is longer than the shots it joins, so the blend becomes the slowest thing on screen."
    }
  ],
