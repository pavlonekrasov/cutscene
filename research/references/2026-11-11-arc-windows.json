    "cursor": "the Windows arrow, enlarged",
    "frame": "full-bleed; UI shots on the Windows 11 desktop",
    "aspect": "16:9, 24 fps",
    "sound": "an audio track with rhythmic onsets (not listened to)"
  },
  "curveFits": [],
  "classify": "Motion-designed launch montage: archival Windows footage, kinetic type, a counter, then real Arc UI on Windows. Conventions: nostalgia cold open, stat card, typing close-up, a gag before the end card.",
  "diagnose": [
    {
      "observation": "The search field is filmed so one word fills the width.",
      "principle": "Legibility at phone size: typing is the action, so the text being typed is the largest thing in frame."
    },
    {
      "observation": "The counter is a number ticker, not a sentence.",
      "principle": "A stat card proves demand faster than a claim card."
    },
    {
      "observation": "The camera never moves; the edit and the content carry all motion.",
      "principle": "One motion source at a time: with fast cutting, a moving camera would add a second, competing motion."
    }
  ],
  "teaches": [
    {
      "tag": "confirms",
      "text": "Typing is shown in close-up, the field at ×2 or more.",
      "setting": "camera: typing zoom"
