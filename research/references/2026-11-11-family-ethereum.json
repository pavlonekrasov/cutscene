  "whyTopTier": "A 47 s platform launch in chapters. Each chapter is a verb card ('Sign up your way', 'Verify that it's you', 'Send tokens', 'Send NFTs', 'Sign in with Family') followed by one floating panel doing exactly that, on a backdrop colour of its own. 41 shots, median 1.0 s.",
  "instrument": "Still 82%: the motion is panels sliding in and cards building, mostly next to cuts. The one fitted pan (33.78) is a panel entering, rms 7.6%: too loose to count.",
  "byEye": {
    "zoom": "panels shown whole and floating (a phone screen, a send card, a connect dialog); typed values at about ×2",
    "cards": "about 12: 'Getting into crypto', 'Just got easier', 'Sign up your way', 'Verify that it's you', 'One self-custody account', 'All your wallets', 'Now available in your browser', 'Send tokens', 'Send NFTs', 'Sign in with Family', 'One seamless … for every app', 'Your Control'",
    "cursor": "a yellow tap dot",
    "frame": "flat colour fields with soft shapes, a new colour per chapter (cream, blue, purple, yellow, teal)",
    "aspect": "16:9, 1280×720, 30 fps",
    "sound": "an audio track with rhythmic onsets (not listened to)"
  },
  "curveFits": [],
  "classify": "Motion-designed launch film for a new product surface (a browser wallet). Conventions: verb chapter cards, single-panel UI demos, illustrated mascots, a logo with the URL.",
  "diagnose": [
    {
      "observation": "Every chapter opens on a verb card, then one panel performs that verb.",
      "principle": "Claim then proof, chunked: one action per chapter keeps 47 s legible without narration."
    },
    {
      "observation": "Each chapter has its own backdrop colour.",
      "principle": "Colour as a chapter marker (wayfinding): the colour change says 'next feature' before the card is read."
    },
    {
      "observation": "The UI is shown as single floating panels; the full window appears once, for 'in your browser'.",
      "principle": "Isolation by default; context only where context is the claim."
    },
    {
      "observation": "41 shots at a 1.0 s median but 82% still.",
      "principle": "Fast cutting of held frames: the rhythm comes from the cuts, not from camera movement."
    }
  ],
